---
import '../styles/global.css';
import BackgroundFX from '../components/BackgroundFX.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sanyam Jain',
  description = 'CS student at Purdue building AI automation systems, robots, and anything else worth building. Former club footballer and Thai cricketer.',
} = Astro.props;
const fullTitle = title === 'Sanyam Jain' ? title : `${title} | Sanyam Jain`;
---

<!doctype html>
<html lang="en" data-kit="purdue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.classList.toggle('dark', stored ? stored === 'dark' : prefersDark);
          var kit = localStorage.getItem('kit');
          if (kit) root.setAttribute('data-kit', kit);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <BackgroundFX />
    <main>
      <slot />
    </main>

    <script is:inline>
      // Kit switching, shared by the header button and any [data-kit-choice] buttons.
      (function () {
        var KITS = ['purdue', 'thailand', 'india'];
        var NAMES = { purdue: 'Purdue kit', thailand: 'Thailand kit', india: 'India kit' };
        var root = document.documentElement;
        function current() { var k = root.getAttribute('data-kit'); return KITS.indexOf(k) > -1 ? k : 'purdue'; }
        function apply(kit) {
          root.setAttribute('data-kit', kit);
          try { localStorage.setItem('kit', kit); } catch (e) {}
          document.querySelectorAll('[data-kit-choice]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-kit-choice') === kit));
          });
          document.querySelectorAll('[data-kit-label]').forEach(function (el) { el.textContent = NAMES[kit]; });
        }
        document.addEventListener('click', function (e) {
          var choice = e.target.closest('[data-kit-choice]');
          if (choice) { apply(choice.getAttribute('data-kit-choice')); return; }
          if (e.target.closest('[data-kit-cycle]')) {
            apply(KITS[(KITS.indexOf(current()) + 1) % KITS.length]);
          }
        });
        apply(current());
      })();
    </script>
  </body>
</html>
