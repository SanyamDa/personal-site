---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { problems } from '../data/content';
---

<Layout title="Problems" description="The problems Sanyam Jain wants to keep out of the net.">
  <PageHead section="problems" intro="A keeper's job is to stop things getting through. These are the problems I want to keep out of the net, and how far along I am with each." />

  <section class="wrap">
    <div class="legend" aria-label="Status key">
      <span><i class="s scouting"></i>Scouting: still understanding it</span>
      <span><i class="s training"></i>Training: building toward it</span>
      <span><i class="s pitch"></i>On the pitch: actively working on it</span>
    </div>

    {problems.length === 0 ? (
      <p class="slot">The problems list is coming soon.</p>
    ) : (
      <ol class="list">
        {problems.map((p) => (
          <li class="problem">
            <span class={`badge ${p.status === 'Scouting' ? 'scouting' : p.status === 'Training' ? 'training' : 'pitch'}`}>{p.status}</span>
            <h2>{p.title}</h2>
            <p>{p.why}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
</Layout>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-bottom: 22px;
    font-size: 14.5px;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .s { display: inline-block; width: 12px; height: 12px; border-radius: 50%; }
  .scouting { background: #8A928C; }
  .training { background: #E2A12B; }
  .pitch { background: #2FA35A; }

  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .problem {
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 20px;
    padding: 20px 22px;
  }
  .badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .badge.training { color: #121614; }
  .problem h2 { margin: 10px 0 6px; font-size: 22px; font-stretch: 110%; }
  .problem p { margin: 0; color: var(--ink-muted); max-width: 65ch; }
</style>
