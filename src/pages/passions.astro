---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { passions } from '../data/content';
---

<Layout title="Passions" description="What Sanyam Jain does off the keyboard: football, cricket, drums, and the outdoors.">
  <PageHead section="passions" intro="The number 10 runs the game from the middle. This is what drives me when I am away from the keyboard." />

  <section class="wrap grid">
    {passions.map((p) => (
      <article class={`passion ${p.sport}`}>
        <div class="art" aria-hidden="true">
          {p.sport === 'football' && (
            <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" class="fill-w" /><path d="M32 20 L42 27.5 L38.2 39 L25.8 39 L22 27.5 Z" class="fill-k" /><path d="M32 6 V20 M42 27.5 L56 23 M38.2 39 L46.5 51 M25.8 39 L17.5 51 M22 27.5 L8 23" class="stroke-k" /></svg>
          )}
          {p.sport === 'cricket' && (
            <svg viewBox="0 0 64 64"><rect x="27" y="6" width="10" height="40" rx="4" transform="rotate(32 32 32)" class="fill-wood" /><rect x="29.5" y="40" width="5" height="16" rx="2" transform="rotate(32 32 32)" class="fill-k" /><circle cx="48" cy="46" r="8" class="fill-red" /><path d="M42 41 C46 44, 50 48, 53 52" class="stroke-w" /></svg>
          )}
          {p.sport === 'drums' && (
            <svg viewBox="0 0 64 64"><ellipse cx="32" cy="30" rx="22" ry="7" class="fill-w" /><path d="M10 30 V44 C10 48, 54 48, 54 44 V30" class="fill-red" /><ellipse cx="32" cy="30" rx="22" ry="7" class="stroke-k" /><path d="M14 8 L30 26 M50 8 L36 26" class="stroke-wood" /></svg>
          )}
          {p.sport === 'outdoors' && (
            <svg viewBox="0 0 64 64"><circle cx="46" cy="16" r="6" class="fill-sun" /><path d="M4 54 L24 22 L36 40 L44 30 L60 54 Z" class="fill-hill" /><path d="M24 22 L30 31 L26 30 L22 33 L19 30 Z" class="fill-w" /></svg>
          )}
        </div>
        <div class="body">
          <h2 class="display">{p.title}</h2>
          <p class="place">{p.place}</p>
          <p class="text">{p.body}</p>
        </div>
      </article>
    ))}
  </section>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .passion {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    align-items: center;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 24px;
    padding: 20px;
  }
  .art {
    aspect-ratio: 1;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(90deg, var(--turf) 0 16px, var(--turf-2) 16px 32px);
  }
  .cricket .art { background: repeating-linear-gradient(90deg, #6E8F3A 0 16px, #7A9C44 16px 32px); }
  .drums .art { background: var(--board); }
  .outdoors .art { background: linear-gradient(#7FC3E8, #BFE3F2); }
  .art svg { width: 70%; height: 70%; }
  .art :global(.fill-w) { fill: #fff; }
  .art :global(.fill-k) { fill: #121614; }
  .art :global(.fill-red) { fill: #C8102E; }
  .art :global(.fill-wood) { fill: #E3C08A; stroke: #8A6233; stroke-width: 1.5; }
  .art :global(.fill-sun) { fill: #FFD25A; }
  .art :global(.fill-hill) { fill: #1E6B3A; }
  .art :global(.stroke-k) { fill: none; stroke: #121614; stroke-width: 2.5; }
  .art :global(.stroke-w) { fill: none; stroke: #fff; stroke-width: 1.5; stroke-dasharray: 2 2; }
  .art :global(.stroke-wood) { fill: none; stroke: #E3C08A; stroke-width: 3.5; stroke-linecap: round; }

  .body h2 { margin: 0; font-size: 38px; }
  .place { margin: 4px 0 0; font-weight: 700; color: var(--kit-ui); font-size: 15px; }
  .text { margin: 8px 0 0; color: var(--ink-muted); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .passion { grid-template-columns: 92px 1fr; gap: 16px; padding: 16px; }
  }
</style>
