---
import { about } from '../data/content';
---

<section id="about" class="max-w-5xl mx-auto px-6 mb-20 scroll-mt-20 reveal">
  <h2 class="font-display text-xl font-semibold mb-6 pb-3 border-b" style="color:var(--ink); border-color:var(--line);">
    About
  </h2>
  <ul class="max-w-[62ch] space-y-2.5">
    {about.map((line) => (
      <li class="text-[15.5px] leading-relaxed pl-4 relative" style="color:var(--ink);">
        <span class="absolute left-0 top-[0.65em] w-1.5 h-1.5 rounded-full" style="background:var(--accent-warm);"></span>
        {line}
      </li>
    ))}
  </ul>
</section>
