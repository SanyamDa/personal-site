---
import { projects } from '../data/content';

const N = Math.min(projects.length, 4); // cube geometry: at most 4 usable side faces
const FACE_ANGLE = 90; // real cube faces sit 90deg apart

const gradients = [
  'linear-gradient(160deg, var(--accent), #6E56CF)',
  'linear-gradient(160deg, var(--accent-warm), #E2574C)',
  'linear-gradient(160deg, #16A18B, var(--accent))',
];

const icons = [
  // automation: connected nodes
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 6h10M6.5 7.7 11 16.3M17.5 7.7 13 16.3"/></svg>`,
  // robot / speech
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="8" width="14" height="10" rx="2"/><path d="M12 8V4M9 4h6M9 13v2M15 13v2"/><path d="M3 12h2M19 12h2"/></svg>`,
  // budgeting / chart
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V10M11 20V4M18 20v-7"/><path d="M3 20h18"/></svg>`,
];

// front(0) / top(1) / back(2) / bottom(3) — project faces fill these in order, tumbling around X.
// index1 sits at -90 (not +90) so that a POSITIVE scroll rotation visits it — this is what
// flips the perceived tumble direction versus the previous version.
const sideTransforms = [
  'rotateX(0deg)',
  'rotateX(-90deg)',
  'rotateX(180deg)',
  'rotateX(90deg)',
];
---

<section id="projects" class="scroll-mt-20">
  <!-- Section heading (always visible, both modes). In enhanced mode this node gets
       moved by JS into the pinned carousel so it stays visually grouped with the
       cuboid instead of leaving a gap above and dead space below it. -->
  <div class="max-w-5xl mx-auto px-6 pt-2" id="projects-heading">
    <h2 class="font-display text-xl font-semibold mb-6 pb-3 border-b" style="color:var(--ink); border-color:var(--line);">Projects</h2>
  </div>

  <!-- ===== Fallback: plain stacked cards (default, always in DOM, works with no JS) ===== -->
  <div id="projects-fallback" class="max-w-5xl mx-auto px-6 pt-8 pb-12">
    <div class="flex flex-col gap-5">
      {projects.map((p) => (
        <article class="rounded-lg border p-5 sm:p-6 glass" style="border-color:var(--line);">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <h3 class="font-display text-base font-semibold" style="color:var(--ink);">{p.name}</h3>
            <span class="font-display text-[11px]" style="color:var(--ink-faint);">{p.period}</span>
          </div>
          <p class="font-display text-[11px] tracking-wide uppercase mb-3" style="color:var(--accent);">{p.tag}</p>
          <ul class="mb-4 space-y-1.5">
            {p.bullets.map((b) => (
              <li class="text-[14px] leading-relaxed pl-3.5 relative" style="color:var(--ink);">
                <span class="absolute left-0 top-[0.6em] w-1 h-1 rounded-full" style="background:var(--ink-faint);"></span>
                {b}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-1.5 mb-3">
            {p.stack.map((s) => (
              <span class="font-display text-[10.5px] px-2 py-0.5 rounded" style="background:var(--surface-2); color:var(--ink-muted);">{s}</span>
            ))}
          </div>
          {p.links && (
            <div class="flex gap-4">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="font-display text-[12.5px]" style="color:var(--accent);">{l.label} &#8599;</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>

  <!-- ===== Enhanced: pinned single-cuboid scroll story (desktop + motion-ok only, JS-activated) =====
       Note on usability: this does NOT hijack scroll. The wheel/trackpad still moves the real
       page scrollbar at normal speed — we only read the resulting scroll position to drive the
       cuboid's rotation while it's pinned (same pattern as Apple's product pages). Nothing traps
       input, nav links still jump straight past it, and a plain stacked-card fallback renders
       instead of this on mobile or when the OS has reduced motion turned on. -->
  <div id="projects-carousel" class="hidden" style={`--n:${N}; --angle:${FACE_ANGLE}deg;`}>
    <div id="carousel-track">
      <div id="carousel-sticky">
        <div class="carousel-inner" id="carousel-inner">
          <div class="stage-wrap" id="stage-wrap">
            <div id="cube">
              {projects.slice(0, N).map((p, i) => (
                <div
                  class="face face-side"
                  data-index={i}
                  style={`transform:${sideTransforms[i]} translateZ(calc(var(--cube-thick) / 2)); background:${gradients[i % gradients.length]};`}
                >
                  <div class="face-head">
                    <div class="face-icon" set:html={icons[i % icons.length]} />
                    <p class="face-meta">{p.tag}</p>
                    <p class="face-meta face-meta-dim">{p.period}</p>
                    <h3 class="face-name">{p.name}</h3>
                  </div>
                  <div class="face-body">
                    <ul class="face-bullets">
                      {p.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                    <div class="face-stack">
                      {p.stack.map((s) => <span>{s}</span>)}
                    </div>
                    {p.links && (
                      <div class="face-links">
                        {p.links.map((l) => (
                          <a href={l.href} target="_blank" rel="noopener">{l.label} &#8599;</a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
              <div class="face face-shell" style="transform: rotateX(90deg) translateZ(calc(var(--cube-thick) / 2));"></div>
              <div class="face face-shell" style="transform: rotateY(90deg) translateZ(calc(var(--cube-w) / 2)); width:var(--cube-thick); height:var(--cube-thick);"></div>
              <div class="face face-shell" style="transform: rotateY(-90deg) translateZ(calc(var(--cube-w) / 2)); width:var(--cube-thick); height:var(--cube-thick);"></div>
            </div>
          </div>

          <div class="dots">
            {projects.map((_, i) => <span class="dot" data-dot={i}></span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #projects-carousel {
    position: relative;
  }
  #projects-carousel.active {
    display: block;
  }

  #carousel-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .carousel-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }

  #projects-heading.in-carousel {
    width: var(--cube-w, 100%);
    max-width: none;
    padding: 0;
  }

  .stage-wrap {
    --cube-w: clamp(520px, 88vw, 1000px);
    --cube-thick: clamp(240px, 36vh, 360px);
    perspective: 2200px;
    width: var(--cube-w);
    height: var(--cube-thick);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    /* extra clearance above the cube (beyond the heading's own mb-6 + the
       carousel-inner gap) so the tumbling cuboid's diagonal mid-rotation
       silhouette never touches the heading's divider line */
    margin-top: 40px;
  }
  .stage-wrap.dragging {
    cursor: grabbing;
  }

  #cube {
    position: relative;
    width: var(--cube-w);
    height: var(--cube-thick);
    transform-style: preserve-3d;
    transition: transform 0.05s linear;
  }
  #cube.snapping {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    backface-visibility: hidden;
  }

  .face-side {
    padding: clamp(28px, 3.2vw, 44px);
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: clamp(20px, 3vw, 40px);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14), 0 30px 80px -30px rgba(0,0,0,0.6);
    overflow: hidden;
  }

  .face-shell {
    background: linear-gradient(160deg, var(--surface-2), var(--surface));
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .face-head {
    flex: 0 0 auto;
    width: clamp(140px, 24%, 220px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: clamp(16px, 2vw, 28px);
    border-right: 1px solid rgba(255,255,255,0.18);
  }

  .face-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }

  .face-icon {
    width: 28px;
    height: 28px;
    opacity: 0.9;
    margin-bottom: 4px;
  }

  .face-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }
  .face-meta-dim {
    opacity: 0.65;
    margin-top: -4px;
  }

  .face-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(17px, 1.8vw, 22px);
    text-wrap: balance;
    line-height: 1.18;
    margin-top: 4px;
  }

  .face-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .face-bullets li {
    position: relative;
    padding-left: 14px;
    font-size: clamp(12.5px, 1.25vw, 14.5px);
    line-height: 1.42;
    opacity: 0.94;
  }
  .face-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.7);
  }

  .face-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
  .face-stack span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 3px 8px;
    border-radius: 5px;
    background: rgba(255,255,255,0.16);
  }

  .face-links {
    display: flex;
    gap: 16px;
  }
  .face-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.9;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 9px;
    /* extra clearance beyond .carousel-inner's gap so the tumbling cuboid's
       diagonal mid-rotation silhouette (taller than its resting height) never
       touches the dots */
    margin-top: 40px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .dot.active {
    background: var(--accent);
    transform: scale(1.5);
  }
</style>

<script>
  function initProjectsCarousel() {
    const carousel = document.getElementById('projects-carousel') as HTMLElement | null;
    const track = document.getElementById('carousel-track') as HTMLElement | null;
    const carouselInner = document.getElementById('carousel-inner') as HTMLElement | null;
    const stageWrap = document.getElementById('stage-wrap') as HTMLElement | null;
    const cube = document.getElementById('cube') as HTMLElement | null;
    const fallback = document.getElementById('projects-fallback') as HTMLElement | null;
    const heading = document.getElementById('projects-heading') as HTMLElement | null;
    if (!carousel || !track || !carouselInner || !stageWrap || !cube || !fallback) return;

    const N = parseInt(getComputedStyle(carousel).getPropertyValue('--n')) || 1;
    const anglePerCard = 90;
    const dots = Array.from(carousel.querySelectorAll('.dot')) as HTMLElement[];

    const canEnhance = window.matchMedia('(min-width: 560px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      N > 1;

    if (!canEnhance) return;

    carousel.classList.add('active');
    fallback.style.display = 'none';
    track.style.height = `${N * 100}vh`;

    // Group the heading with the pinned cuboid+dots instead of leaving it stranded
    // above with dead space below — moves the real node, no duplicate heading.
    if (heading) {
      heading.classList.add('in-carousel');
      carouselInner.insertBefore(heading, carouselInner.firstChild);
    }

    let activeIndex = -1;
    let scrollRotation = 0; // base rotation derived purely from scroll position
    let dragOffset = 0; // temporary offset added while/just after dragging

    function render() {
      if (!cube) return;
      cube.style.transform = `rotateX(${scrollRotation + dragOffset}deg)`;
    }

    function setActive(i: number) {
      if (i === activeIndex) return;
      activeIndex = i;
      dots.forEach((el) => el.classList.toggle('active', Number(el.dataset.dot) === i));
    }
    setActive(0);

    function onScroll() {
      if (!track) return;
      const rect = track.getBoundingClientRect();
      const scrollable = track.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, scrolled / scrollable)) : 0;

      scrollRotation = progress * (N - 1) * anglePerCard;
      render();

      const idx = Math.round(progress * (N - 1));
      setActive(idx);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Bonus: drag-to-spin. Purely a tactile toy — it always eases back to the
    // scroll-derived rotation on release so the cuboid can never drift out of
    // sync with which project is marked active in the dots.
    let dragging = false;
    let startY = 0;
    let snapTimeout: ReturnType<typeof setTimeout> | null = null;

    function pointerDown(clientY: number) {
      dragging = true;
      startY = clientY;
      cube!.classList.remove('snapping');
      stageWrap!.classList.add('dragging');
      if (snapTimeout) clearTimeout(snapTimeout);
    }
    function pointerMove(clientY: number) {
      if (!dragging) return;
      // dragging down should tumble the box the same direction scrolling down does
      dragOffset = (clientY - startY) * 0.4;
      render();
    }
    function pointerUp() {
      if (!dragging) return;
      dragging = false;
      stageWrap!.classList.remove('dragging');
      cube!.classList.add('snapping');
      dragOffset = 0;
      render();
      snapTimeout = setTimeout(() => cube!.classList.remove('snapping'), 550);
    }

    stageWrap.addEventListener('mousedown', (e) => pointerDown(e.clientY));
    window.addEventListener('mousemove', (e) => pointerMove(e.clientY));
    window.addEventListener('mouseup', pointerUp);

    stageWrap.addEventListener('touchstart', (e) => pointerDown(e.touches[0].clientY), { passive: true });
    window.addEventListener('touchmove', (e) => pointerMove(e.touches[0].clientY), { passive: true });
    window.addEventListener('touchend', pointerUp);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsCarousel);
  } else {
    initProjectsCarousel();
  }
</script>
