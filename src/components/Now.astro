---
import { now } from '../data/content';
---

<section class="max-w-5xl mx-auto px-6 mb-16 reveal">
  <div class="rounded-lg border p-5 glass" style="border-color:var(--line-strong);">
    <p class="font-display text-[11px] tracking-widest uppercase mb-3" style="color:var(--ink-faint);">
      Current Work
    </p>
    <ul class="space-y-1.5">
      {now.items.map((item) => (
        <li class="text-[14.5px] flex gap-2" style="color:var(--ink);">
          <span style="color:var(--accent-warm);">&rarr;</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
