---
const kits = [
  { key: 'purdue', label: 'Purdue', a: '#CFB991', b: '#121614' },
  { key: 'thailand', label: 'Thailand', a: '#00247D', b: '#EF3340' },
  { key: 'india', label: 'India', a: '#312C6A', b: '#FFFFFF' },
];
---

<div class="kits" role="group" aria-label="Choose a kit">
  <span class="kits-label">Pick a kit</span>
  {kits.map((k) => (
    <button type="button" class="kit" data-kit-choice={k.key} aria-pressed="false">
      <span class="sw" style={`--a:${k.a};--b:${k.b}`} aria-hidden="true"></span>
      {k.label}
    </button>
  ))}
  <button id="theme-toggle" type="button" class="kit night" aria-label="Switch between day and night match">
    <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><g stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></g></svg>
    <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    <span class="day-label">Day match</span><span class="night-label">Night match</span>
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
    });
  })();
</script>

<style>
  .kits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .kits-label { font-weight: 600; color: var(--ink-muted); margin-right: 4px; font-size: 15px; }
  .kit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 14px/1 var(--font-sans);
    padding: 7px 13px 7px 7px;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .kit:hover { border-color: var(--ink); }
  .kit[aria-pressed="true"] { border-color: var(--ink); background: var(--surface-2); }
  .night { padding: 7px 13px 7px 10px; margin-left: 6px; }
  .night svg { fill: currentColor; stroke: currentColor; }
  .night .sun circle { stroke: none; }
  .moon, .night-label { display: none; }
  :global(:root.dark) .sun, :global(:root.dark) .day-label { display: none; }
  :global(:root.dark) .moon, :global(:root.dark) .night-label { display: inline; }
  .sw {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--a) 0 55%, var(--b) 55% 100%);
    box-shadow: inset 0 0 0 1.5px rgba(0,0,0,.25);
  }
</style>
