---
import { experience, education, achievements, skills } from '../data/content';
---

<section id="experience" class="max-w-5xl mx-auto px-6 mb-20 scroll-mt-20 reveal">
  <h2 class="font-display text-xl font-semibold mb-6 pb-3 border-b" style="color:var(--ink); border-color:var(--line);">
    Experience
  </h2>
  <div class="flex flex-col gap-5 mb-12">
    {experience.map((e) => (
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-1">
        <div class="sm:w-40 shrink-0 font-display text-[11.5px]" style="color:var(--ink-faint);">
          {e.period}
        </div>
        <div class="flex-1">
          <p class="text-[15px] font-medium flex items-center gap-2" style="color:var(--ink);">
            {e.role} &middot; {e.org}
            {e.current && (
              <span class="font-display text-[10px] px-1.5 py-0.5 rounded" style="background:var(--accent-warm-bg); color:var(--accent-warm);">
                current
              </span>
            )}
          </p>
          {e.bullets.length > 0 && (
            <ul class="mt-1 space-y-1">
              {e.bullets.map((b) => (
                <li class="text-[14px]" style="color:var(--ink-muted);">{b}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>

  <h3 class="font-display text-[12px] tracking-widest uppercase mb-4" style="color:var(--ink-faint);">
    Highlights
  </h3>
  <div class="grid sm:grid-cols-2 gap-4 mb-12">
    {achievements.map((a) => (
      <div class="rounded-lg border p-4 glass" style="border-color:var(--line);">
        <p class="font-display font-semibold mb-2" style="color:var(--accent); font-size:clamp(15px,1.6vw,17px); line-height:1.3;">{a.stat}</p>
        <p class="text-[13px] leading-relaxed" style="color:var(--ink-muted);">{a.detail}</p>
      </div>
    ))}
  </div>

  <h3 class="font-display text-[12px] tracking-widest uppercase mb-4" style="color:var(--ink-faint);">
    Education
  </h3>
  <div class="flex flex-col gap-3 mb-12">
    {education.map((ed) => (
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
        <p class="text-[15px]" style="color:var(--ink);">
          <span class="font-medium">{ed.school}</span>, {ed.detail}
        </p>
        <span class="font-display text-[11.5px]" style="color:var(--ink-faint);">{ed.period}</span>
      </div>
    ))}
  </div>

  <h3 class="font-display text-[12px] tracking-widest uppercase mb-4" style="color:var(--ink-faint);">
    Skills
  </h3>
  <div class="flex flex-wrap gap-1.5">
    {skills.map((s) => (
      <span class="font-display text-[11.5px] px-2.5 py-1 rounded-full border" style="border-color:var(--line-strong); color:var(--ink-muted);">
        {s}
      </span>
    ))}
  </div>
</section>
